[Unit]
Description=Seva Flask/PWA service
Documentation=file:/srv/seva/current/DEPLOYMENT.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=seva
Group=seva
WorkingDirectory=/srv/seva/current
EnvironmentFile=/etc/seva/seva.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/seva/current/.venv/bin/gunicorn -c gunicorn.conf.py wsgi:app
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/seva
UMask=0077

[Install]
WantedBy=multi-user.target
