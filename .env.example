# Seva production environment template.
# Do not copy real secret values into this file or commit a filled-in copy.
# On the host, put these in the platform secret manager or a root-protected
# environment file such as /etc/seva/seva.env (mode 0640, owned by root:seva).

SEVA_ENV=production

# Set provider secrets only when enabling those paid provider features.
GNANI_API_KEY=replace-me
GEMINI_API_KEY=replace-me

# Optional provider settings.
GEMINI_MODEL=gemini-3.5-flash-lite
# GNANI_BASE_URL=https://api.vachana.ai
# GNANI_AUTH_HEADER=X-API-Key-ID

# Absolute path on the persistent volume.
SEVA_DATA_DIR=/var/lib/seva

# Comma-separated public hostnames. No scheme, path, or trailing slash.
SEVA_ALLOWED_HOSTS=seva.example.org

# Public production deployments must require preview authentication until
# hospital data and billable provider access are explicitly approved.
SEVA_PREVIEW_AUTH_REQUIRED=1
SEVA_PREVIEW_USERNAME=demo
SEVA_PREVIEW_PASSWORD=replace-me
SEVA_HOSPITAL_DATA_APPROVED=0

# Gunicorn / proxy settings.
PORT=8000
LOG_LEVEL=info
# Recommended when Caddy or another trusted proxy runs on the same host:
SEVA_BIND_HOST=127.0.0.1
# Enable only when exactly one trusted proxy overwrites forwarded headers.
SEVA_TRUST_PROXY=1

# Development-only routes. Keep 0 for public hosting.
SEVA_ENABLE_SERVER_MIC=0
SEVA_ENABLE_SIMULATE=0
SEVA_ENABLE_USAGE_API=0
# Fixed synthetic examples only; no microphone, Gnani, or Gemini calls.
SEVA_ENABLE_SYNTHETIC_DEMO=1
